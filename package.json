{
  "name": "sld-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Headless single-line diagram engine (monorepo root).",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev:example": "pnpm --filter @sld-kit-examples/svelte dev",
    "build:example": "pnpm --filter @sld-kit-examples/svelte build",
    "dev:example:react": "pnpm --filter @sld-kit-examples/react dev",
    "build:example:react": "pnpm --filter @sld-kit-examples/react build",
    "start:node": "pnpm --filter @sld-kit-examples/node start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
